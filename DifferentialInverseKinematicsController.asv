clc, clear all
robot = createRigidBodyTree;
robot.DataFormat = "column";
robot.Gravity = [0; 0; -9.81];

eeName = "end_effector";

dt = 0.02;
Tfinal = 5;
t = 0:dt:Tfinal;

q = [0; 0; 0; 0];              % joint angles, rad
x_des = [0.20; 0.10; 0.15];    % desired EE position, m
Kp = 2.0;

figure;
for k = 1:length(t)

    % Forward kinematics
    T = getTransform(robot, q, eeName);
    x = T(1:3,4);

    % Translation error
    e = x_des - x;

    % Desired end-effector linear velocity
    v_des = Kp * e;

    % Full geometric Jacobian
    J = geometricJacobian(robot, q, eeName);

    % Translation part only
    Jv = J(4:6, :);

    % Differential IK: qdot = pinv(Jv) * v
    qdot_cmd = pinv(Jv) * v_des;

    % Optional velocity saturation
    maxVel = 1.0; % rad/s
    qdot_cmd = max(min(qdot_cmd, maxVel), -maxVel);

    % Simulate robot motion by integrating joint velocities
    q = q + qdot_cmd * dt;

    % Visualize
    show(robot, q, "PreservePlot", false, "Frames", "off");
    hold on;
    plot3(x_des(1), x_des(2), x_des(3), "ro", "MarkerSize", 8, "LineWidth", 2);
    hold off;
    axis([-0.1 0.4 -0.3 0.3 0 0.4]);
    drawnow;
end